// Обмен с кассой Mobilkassa по прежней схеме (порт 6461, протокол 1.0.2).
// Фрагмент выгрузки конфигурации в файлы: общий модуль КассаMobilkassa.

Функция ВызватьКассу(Метод, Параметры) Экспорт

	Соединение = Новый HTTPСоединение(Константы.АдресКассы.Получить(), 6461, , , , 30);
	Запрос = Новый HTTPЗапрос("/pospoint");
	Запрос.Заголовки.Вставить("Content-Type", "application/json");

	Тело = Новый Структура("id, key, version, method, params", "1", Константы.КлючКассы.Получить(), "1.0.2", Метод, Параметры);
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Тело);
	Запрос.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

	Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
	Возврат ПрочитатьJSON(Чтение);

КонецФункции

Процедура ПробитьЧек(ДокументОбъект) Экспорт

	Позиции = Новый Массив;
	Для Каждого СтрокаТовара Из ДокументОбъект.Товары Цикл
		Позиция = Новый Структура;
		Позиция.Вставить("name", Строка(СтрокаТовара.Номенклатура));
		Позиция.Вставить("amount", СтрокаТовара.Количество);
		Позиция.Вставить("price", СтрокаТовара.Цена);
		Позиция.Вставить("mxik", СтрокаТовара.Номенклатура.ИКПУ);
		Позиция.Вставить("ownerType", 0);
		Позиция.Вставить("unit", СтрокаТовара.Номенклатура.КодЕдиницы);
		Позиция.Вставить("packageCode", СтрокаТовара.Номенклатура.КодУпаковки);
		Позиция.Вставить("taxPercent", СтрокаТовара.СтавкаНДС);
		Позиции.Добавить(Позиция);
	КонецЦикла;

	Параметры = Новый Структура("items, byCash, byCard", Позиции, ДокументОбъект.СуммаНаличными, ДокументОбъект.СуммаКартой);
	Ответ = ВызватьКассу("registerSaleFull", Параметры);
	Результат = Ответ.result;

	ДокументОбъект.НомерЧекаКассы = Результат.id;
	ДокументОбъект.ФискальныйПризнак = Результат.fiscalSign;
	ДокументОбъект.НомерФМ = Результат.fmNo;
	ДокументОбъект.НомерСмены = Результат.shiftNumber;
	ДокументОбъект.Записать();

	НапечататьQRКод(Результат.url);

КонецПроцедуры

Процедура ВернутьЧек(ДокументВозврата) Экспорт

	Позиции = Новый Массив;
	Для Каждого СтрокаТовара Из ДокументВозврата.Товары Цикл
		Позиция = Новый Структура("name, amount, price, mxik", Строка(СтрокаТовара.Номенклатура),
			СтрокаТовара.Количество, СтрокаТовара.Цена, СтрокаТовара.Номенклатура.ИКПУ);
		Позиции.Добавить(Позиция);
	КонецЦикла;

	Параметры = Новый Структура("idRefundReceipt, items, byCash, byCard",
		ДокументВозврата.ДокументПродажи.НомерЧекаКассы, Позиции, ДокументВозврата.СуммаНаличными, 0);
	Ответ = ВызватьКассу("registerRefundFull", Параметры);
	ДокументВозврата.ФискальныйПризнак = Ответ.result.fiscalSign;
	ДокументВозврата.Записать();

КонецПроцедуры

Функция ПолучитьЧек(НомерДокумента) Экспорт

	Возврат ВызватьКассу("getReceiptByPayCheckNumber", Новый Структура("payCheckNumber", НомерДокумента)).result;

КонецФункции

Процедура СнятьXОтчет() Экспорт

	ВызватьКассу("getXReport", Новый Структура);

КонецПроцедуры

Процедура НапечататьQRКод(Ссылка)

	Макет = ПолучитьОбщийМакет("ЧекСQRКодом");
	Макет.Области.QRКод.Картинка = ГенераторQRКода.Картинка(Ссылка);
	Макет.Показать();

КонецПроцедуры
