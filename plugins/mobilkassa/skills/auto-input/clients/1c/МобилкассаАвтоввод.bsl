// Общий модуль МобилкассаАвтоввод (сервер): предчеки кассы Mobilkassa, порт 6461, протокол 1.0.2.
// Добавьте его в расширение конфигурации. Параметры — структура из ПараметрыКассы().
//
// Каждая функция возвращает Структуру:
//   Вид       — "Оформлен", "Ожидает", "Отклонён" или "Ошибка";
//   Результат — Соответствие с ответом кассы (для "Оформлен": payCheckNumber, status, type, changed, items, payments, total);
//   Ошибки    — Массив Соответствий с code и message (для "Ошибка"; code 0 — нет связи с кассой).
// "Ожидает": кассир ещё не оформил предчек (14827 или истёк таймаут). Спрашивайте СтатусПредчека позже.
// "Отклонён": кассир отклонил предчек (14828). Исправленный предчек можно отправить с тем же номером.

// Адрес и ключ — из блока «Автоввод данных чека» в настройках кассы. Таймаут больше 90 секунд удержания.
Функция ПараметрыКассы(Адрес, Ключ, Порт = 6461, Таймаут = 120) Экспорт

	Возврат Новый Структура("Адрес, Порт, Ключ, Таймаут", Адрес, Порт, Ключ, Таймаут);

КонецФункции

// Предчек продажи: Структура или Соответствие с payCheckNumber, type ("SALE", "ADVANCE", "CREDIT"), items и,
// при желании, byCash и byCard. Всегда передавайте свой payCheckNumber: повтор с ним не создаст второго чека.
// Вызов ждёт, пока кассир оформит или отклонит предчек.
Функция ОтправитьПредчек(Параметры, Предчек) Экспорт

	Возврат Отправить(Параметры, "sendPreReceipt", Предчек);

КонецФункции

// Предчек возврата: payCheckNumber, salePayCheckNumber или saleId (бывший idRefundReceipt), items с amount и sku
// (или uid, mxik, barcode, name).
Функция ОтправитьПредчекВозврата(Параметры, Возврат) Экспорт

	Возврат Отправить(Параметры, "sendRefundPreReceipt", Возврат);

КонецФункции

// 14824 при повторе: документ уже оформлен (ответ потерялся или учётная система перезапустилась).
// Его состав берётся из СтатусПредчека, поэтому повтор отвечает «Оформлен», а не «Ошибка», которая толкает
// пробить чек второй раз.
Функция Отправить(Параметры, Метод, Документ)

	Итог = ВызватьКассу(Параметры, Метод, Документ);
	Если Итог.Вид = "Ошибка" Тогда
		Для Каждого Ошибка Из Итог.Ошибки Цикл
			Если Ошибка.Получить("code") = 14824 Тогда
				Статус = СтатусПредчека(Параметры, Документ["payCheckNumber"]);
				Если Статус.Вид = "Оформлен" Тогда
					Возврат Статус;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Итог;

КонецФункции

Функция СтатусПредчека(Параметры, НомерДокумента) Экспорт

	Возврат ВызватьКассу(Параметры, "getPreReceiptStatus", Новый Структура("payCheckNumber", НомерДокумента));

КонецФункции

Функция ВызватьКассу(Параметры, Метод, ПараметрыМетода)

	Тело = Новый Структура("id, key, version, method, params",
		Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧГ=0"), Параметры.Ключ, "1.0.2", Метод, ПараметрыМетода);
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Тело);

	Запрос = Новый HTTPЗапрос("/pospoint");
	Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	// Без BOM: касса не разбирает JSON с меткой порядка байтов.
	Запрос.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

	Попытка
		Соединение = Новый HTTPСоединение(Параметры.Адрес, Параметры.Порт, , , , Параметры.Таймаут);
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
		Данные = ПрочитатьJSON(Чтение, Истина);
	Исключение
		Текст = ОписаниеОшибки();
		// Истёк таймаут: предчек мог дойти до кассира, это не ошибка.
		Если ЭтоТаймаут(Текст) Тогда
			Возврат Итог("Ожидает");
		КонецЕсли;
		Ошибка = Новый Соответствие;
		Ошибка.Вставить("code", 0);
		Ошибка.Вставить("message", "Нет связи с кассой: " + Текст);
		Ошибки = Новый Массив;
		Ошибки.Добавить(Ошибка);
		Возврат Итог("Ошибка", , Ошибки);
	КонецПопытки;

	Ошибки = Данные.Получить("error");
	Если Ошибки <> Неопределено И Ошибки.Количество() > 0 Тогда
		Для Каждого Ошибка Из Ошибки Цикл
			Если Ошибка.Получить("code") = 14827 Тогда
				Возврат Итог("Ожидает");
			ИначеЕсли Ошибка.Получить("code") = 14828 Тогда
				Возврат Итог("Отклонён");
			КонецЕсли;
		КонецЦикла;
		Возврат Итог("Ошибка", , Ошибки);
	КонецЕсли;

	Результат = Данные.Получить("result");
	Статус = ?(Результат = Неопределено, Неопределено, Результат.Получить("status"));
	Если Статус = "ISSUED" Тогда
		Возврат Итог("Оформлен", Результат);
	ИначеЕсли Статус = "REJECTED" Тогда
		Возврат Итог("Отклонён", Результат);
	КонецЕсли;
	Возврат Итог("Ожидает", Результат);

КонецФункции

Функция ЭтоТаймаут(ТекстОшибки)

	Текст = НРег(ТекстОшибки);
	Возврат СтрНайти(Текст, "timeout") > 0 Или СтрНайти(Текст, "timed out") > 0
		Или СтрНайти(Текст, "таймаут") > 0 Или СтрНайти(Текст, "время ожидания") > 0;

КонецФункции

Функция Итог(Вид, Результат = Неопределено, Ошибки = Неопределено)

	Возврат Новый Структура("Вид, Результат, Ошибки", Вид, Результат, ?(Ошибки = Неопределено, Новый Массив, Ошибки));

КонецФункции
